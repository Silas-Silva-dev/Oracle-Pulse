# ==========================================
# Oracle Pulse - exemplo de configuração
# Copie para ".env" e preencha. NUNCA versione o .env real.
# ==========================================

# ----- Servidor / Modo de operação -----
PORT=3000
# Endereço de escuta. Vazio = todas as interfaces (inclusive VPNs). Use 127.0.0.1
# se o painel só é acessado na própria máquina, ou o IP da rede de administração.
BIND_HOST=
# HTTPS (recomendado sempre que o painel é acessado pela rede: sem ele a senha e o
# token de sessão trafegam em texto puro). Use um .pfx (com senha, se tiver)...
TLS_PFX_PATH=
TLS_PFX_PASSPHRASE=
# ...ou um par PEM (certificado + chave). Com HTTPS ativo, acesse https://<host>:PORT
# e ajuste o atalho "Abrir Oracle Pulse" (o instalador o cria com http://).
TLS_CERT_PATH=
TLS_KEY_PATH=
# Se true, usa dados simulados e não toca em banco real (ideal para demonstração)
DEMO_MODE=false
# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# ----- Conexão Oracle -----
DB_USER=admin
DB_PASSWORD=troque_esta_senha
DB_HOST=servidor-oracle
DB_PORT=1521
DB_SERVICE=orcl
# Caminho para a pasta \bin do Oracle Client 64-bit (obrigatório no Windows)
ORACLE_CLIENT_PATH=D:\oracle\product\19.3\dbhome_1\bin
# (Opcional) ajuste fino do pool de conexões
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_INCREMENT=1

# ----- Acesso ao SO do servidor de banco (leitura de disco) -----
# Deixe SSH_HOST vazio se o banco roda na mesma máquina do painel.
SSH_HOST=
SSH_USER=
# IMPORTANTE: se a senha tiver "#", espaço ou aspas, coloque-a ENTRE ASPAS,
# senão o .env trunca no "#" (ex.: Senha#2024 vira "Senha"). Ex: SSH_PASSWORD="Senha#2024"
SSH_PASSWORD=
SSH_PORT=22
# Alternativa mais segura à senha: caminho de uma chave privada (use se o
# servidor SÓ aceita chave pública — PasswordAuthentication no)
SSH_PRIVATE_KEY_PATH=
# Fingerprint da chave do SERVIDOR SSH (anti man-in-the-middle). Obtenha NO servidor:
#   Linux:   ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
#   Windows: ssh-keygen -lf C:\ProgramData\ssh\ssh_host_ed25519_key.pub
# e cole o "SHA256:..." aqui (vários separados por vírgula). Vazio = a chave vista na
# 1ª conexão fica registrada em logs\ssh-known-hosts.json e qualquer troca é RECUSADA.
SSH_HOST_FINGERPRINT=
# Diagnóstico do SSH: true imprime o handshake completo do ssh2 no log
SSH_DEBUG=false

# ----- Segurança / Login -----
# Conta DBA (acesso total — inclui o Terminal do servidor: equivale a root/SYSDBA).
# Use senha longa e exclusiva. Gere o hash com:  node bin/hash-password.js "suaSenha"
AUTH_USER=DBA
AUTH_PASS_HASH=
# (Opcional) Conta somente-leitura (perfil "viewer")
AUTH_VIEWER_USER=
AUTH_VIEWER_PASS_HASH=
# Tempo de vida do token de sessão, em minutos (padrão 480 = 8h)
AUTH_TOKEN_TTL_MIN=480

# ----- Ambiente Oracle no SERVIDOR (opcional) -----
# Necessário apenas para o painel APLICAR comandos RMAN/archivelog automaticamente.
# Sem isso, o painel mostra o comando RMAN para você rodar manualmente.
DB_ORACLE_HOME=
DB_ORACLE_SID=
# Usuário do SO dono do Oracle no servidor (ex.: oracle). Em Linux, se o acesso
# SSH é por root, o painel usa "su - <DB_OS_USER>" para rodar o RMAN.
DB_OS_USER=

# Autenticação do RMAN/sqlplus pela SENHA do SYS (recomendado). Com isso o painel
# conecta como "sys/<senha>[@alias]", igual ao que o DBA faz manualmente, e
# funciona mesmo que o usuário do SSH NÃO seja membro do grupo dba do Oracle.
# Sem isso, o painel tenta autenticação por SO (rman target / ; sqlplus / as sysdba).
# Se a senha tiver # ou espaço, use aspas: DB_SYS_PASSWORD="minha#senha".
DB_SYS_USER=sys
DB_SYS_PASSWORD=
# Alias TNS para a conexão. Linux normalmente VAZIO (conexão local via ORACLE_SID);
# Windows costuma exigir, ex.: DB_TNS_ALIAS=master  (=> rman target sys/<senha>@master)
DB_TNS_ALIAS=

# Caminho da FRA (Fast Recovery Area). Opcional: se VAZIO e a FRA ainda não
# estiver configurada, ao definir o tamanho o painel cria a pasta automaticamente
# em <ORACLE_BASE>/fast_recovery_area e a define como DB_RECOVERY_FILE_DEST.
# Preencha para forçar um caminho específico (ex.: um volume dedicado):
#   DB_FRA_DEST=/u02/fast_recovery_area
DB_FRA_DEST=

# ----- Relógio do servidor x NTP -----
# Servidores NTP usados para medir e sincronizar a hora do servidor de banco
# (botão ao lado de "Servidor:" no Dashboard). Separe por vírgula. Padrão: NTP.br.
#   NTP_SERVERS=a.st1.ntp.br,b.st1.ntp.br,pool.ntp.org
# Em rede sem internet, use o NTP interno (ex.: o controlador de domínio).
NTP_SERVERS=

# ----- Recuperação -----
# Caminho do alert log no servidor de banco. Opcional: o painel descobre pelo
# V$DIAG_INFO (e guarda o caminho para quando o banco estiver fora do ar).
#   DB_ALERT_LOG=/u01/app/oracle/diag/rdbms/orcl/orcl/trace/alert_orcl.log
DB_ALERT_LOG=

# ----- Alertas -----
# Webhook opcional (Slack/Teams/Telegram bridge) para notificar alertas novos
ALERT_WEBHOOK_URL=
ALERT_TABLESPACE_PCT=90
ALERT_DISK_PCT=85
ALERT_MEMORY_PCT=90
